{
  "name": "blockwork-library",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed:local": "node scripts/seed.js --local",
    "seed:remote": "node scripts/seed.js --remote",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:runtime": "python3 scripts/test-pack-runtime.py",
    "test:browser": "node --test test-browser/*.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@playwright/test": "^1.65.0",
    "miniflare": "^5.20261019.1-beta",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.3"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@simplewebauthn/server": "^14.1.0",
    "otpauth": "^9.6.0",
    "postal-mime": "^2.4.4",
    "qrcode-generator": "^2.0.4"
  }
}
